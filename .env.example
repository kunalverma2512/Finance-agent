# Copy to .env (never commit .env). Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
LOG_JSON=true

# Database: Local PostgreSQL or Neon Serverless PostgreSQL
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini API (for RAG prompt synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_POLISH_RESPONSES=true

# System Guardrails
MAX_UPLOAD_MB=5
MAX_IMPORT_ROWS=20000
MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=10
MAX_RETRIES=2
MONITOR_INTERVAL_MINUTES=60        # 0 disables the background scheduler
RATE_LIMIT_ENABLED=true
